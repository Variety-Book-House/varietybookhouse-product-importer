# Local Python tools (no LLM): pip install -r requirements.txt
# Used by read_barcodes.py (zxing-cpp), ocr_batch.py (EasyOCR), crop_book.py (rembg + opencv)

# Neon Postgres (same database as the main repo) — required for matching (non-dry-run) and commit
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech:5432/varietybookhouse?sslmode=require

# Cloudflare R2 — required for commit (image uploads)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=products
R2_PUBLIC_URL=https://your-r2-account-id.r2.cloudflarestorage.com

# Web UI port
WEB_PORT=4173

# ISBN enrichment: Google Books metadata (optional key avoids rate limits) + LM Studio local LLM
# Google Books free tier works without a key; add one at https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=
# LM Studio — install from https://lmstudio.ai, open the model (e.g. lmstudio-community/Qwen2.5-1.5B-Instruct-MLX-8bit)
# and enable the Local Server (Developer menu, port 1234).
LLM_HOST=http://127.0.0.1:1234
# Leave empty to auto-pick the currently loaded model in LM Studio
LLM_MODEL=
